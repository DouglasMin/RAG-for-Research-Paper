        "x": 89,
        "y": 553
      }
    ],
    "html": "<br><p id='7' data-category='paragraph' style='font-size:16px'>Domestic truck prices across Europe also mostly<br>strengthened as October started.</p>",
    "text": "Domestic truck prices across Europe also mostly\nstrengthened as October started."
  },
  {
    "id": "14c49974-efb9-48d3-9dce-773d505db7f3",
    "page": 1,
    "type": "paragraph",
    "bounding_box": [
